# Flask: replace this placeholder before any application/container startup.
SECRET_KEY=replace-with-a-long-random-value
FLASK_ENV=production
APP_PORT=7485

# Optional Phase 3 read-only WooCommerce discovery (credentials remain runtime-only)
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Optional Shopify connection/discovery and explicitly confirmed draft publishing.
# Compose passes these through; Unraid has corresponding optional variables.
# Nonempty Shopify authentication/version variables make credentials deployment-owned.
# Native capability/policy flags do not select or merge authentication sources.
# Use an installed app's Admin API access token, never a client secret.
SHOPIFY_STORE_DOMAIN=
## Optional reviewed manufacturing-origin default. Leave blank unless accurate;
## GB may be selected for TLC-made products; authored country overrides it.
DEFAULT_COUNTRY_OF_ORIGIN=
# Optional stable namespace for typed individual-product dimension metafields.
# Changing it does not delete old metafields. These are NOT parcel dimensions.
SHOPIFY_PRODUCT_DIMENSIONS_NAMESPACE=tlc_dashboard
# Optional 2027-01 RELEASE CANDIDATE packed-dimension capability (default OFF).
# Product/collection operations keep SHOPIFY_API_VERSION=2026-10.
# Add write_inventory in the installed app yourself; read_products/read_inventory reads.
SHOPIFY_NATIVE_DIMENSIONS_ENABLED=false
# Explicit policy: only enable when authored mm accurately describe each packed item.
# Otherwise leave false; product dimensions/metafields are NOT inferred package sizes.
SHOPIFY_PACKED_DIMENSIONS_USE_PRODUCT_DIMENSIONS=false
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Use either the complete client pair OR a manual Admin token, never both.
SHOPIFY_API_VERSION=

# Runtime ownership (generic Docker defaults preserve 100:100; Unraid uses 99:100)
PUID=100
PGID=100
UMASK=002

# Discord (disabled by default)
DISCORD_ENABLED=false
DISCORD_DEFAULT_USERNAME=WooCommerce Dashboard
DISCORD_DEFAULT_AVATAR_URL=
DISCORD_WEBHOOK_SCANS_INFO=
DISCORD_WEBHOOK_SCANS_ERRORS=
DISCORD_WEBHOOK_EDITS=
DISCORD_WEBHOOK_OVERRIDES=
DISCORD_WEBHOOK_INGEST=
DISCORD_MAX_FIELD_CHARS=950
DISCORD_MAX_EMBED_FIELDS=10

# Host paths used by Docker Compose
PRODUCT_FOLDER_HOST=/replace/with/product/catalogue/path
OUTPUT_FOLDER_HOST=/replace/with/generated/output/path
INSTANCE_FOLDER_HOST=/replace/with/appdata/woocommerce-dashboard/instance

# Container-owned settings; do not use host mount paths here.
PRODUCT_FOLDER=/catalogue
OUTPUT_FOLDER=/output
URL_PREFIX=
# URL_PREFIX is concatenated with generated filenames unchanged; include the
# trailing slash when your public image base is a directory URL.
INTAKE_ROOT=/intake
INTAKE_FOLDER_HOST=

# Optional local taxonomy workspace (enable compose.taxonomy.yaml explicitly).
# Must be separate from catalogue, output, Intake and instance directories.
TAXONOMY_FOLDER_HOST=
TAXONOMY_ROOT=/taxonomy
