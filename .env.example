# Flask: replace this placeholder before any application/container startup.
SECRET_KEY=replace-with-a-long-random-value
FLASK_ENV=production
APP_PORT=7485

# Optional Phase 3 read-only WooCommerce discovery (credentials remain runtime-only)
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Runtime ownership (generic Docker defaults preserve 100:100; Unraid uses 99:100)
PUID=100
PGID=100
UMASK=002

# Discord (disabled by default)
DISCORD_ENABLED=false
DISCORD_DEFAULT_USERNAME=WooCommerce Dashboard
DISCORD_DEFAULT_AVATAR_URL=
DISCORD_WEBHOOK_SCANS_INFO=
DISCORD_WEBHOOK_SCANS_ERRORS=
DISCORD_WEBHOOK_EDITS=
DISCORD_WEBHOOK_OVERRIDES=
DISCORD_WEBHOOK_INGEST=
DISCORD_MAX_FIELD_CHARS=950
DISCORD_MAX_EMBED_FIELDS=10

# Host paths used by Docker Compose
PRODUCT_FOLDER_HOST=/replace/with/product/catalogue/path
OUTPUT_FOLDER_HOST=/replace/with/generated/output/path
INSTANCE_FOLDER_HOST=/replace/with/appdata/woocommerce-dashboard/instance
